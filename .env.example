# ============================================================
# AI Interview Preparation Assistant - Environment Variables
# ============================================================

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Google AI (Gemini)
GEMINI_API_KEY=your_gemini_api_key

# Groq API (Alternative LLM)
GROQ_API_KEY=your_groq_api_key

# OpenAI API (Alternative LLM)
OPENAI_API_KEY=your_openai_api_key

# Anthropic API (Alternative LLM)
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenRouter API (Alternative LLM)
OPENROUTER_API_KEY=your_openrouter_api_key

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# App Configuration
APP_ENV=development
APP_SECRET_KEY=your_strong_secret_key_here
APP_NAME=AI Interview Prep Assistant

# Storage
SUPABASE_STORAGE_BUCKET=resumes
SUPABASE_DOCS_BUCKET=documents

# RAG Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Voice Configuration
WHISPER_MODEL=base

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=30
MAX_TOKENS_PER_REQUEST=8000
